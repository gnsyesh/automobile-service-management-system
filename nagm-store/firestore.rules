rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.admin == true;
    }


    // =========================================================
    // ADMINS
    // =========================================================

    match /admins/{adminId} {

      // Admin can read their own admin document.
      // Other admins can read admin documents.
      allow read: if isOwner(adminId) || isAdmin();

      // Only admins can create/update/delete admin documents.
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // A customer can read their own profile.
      // Admins can read all customer profiles.
      allow read: if isOwner(userId) || isAdmin();

      // Users can create only their own profile.
      allow create: if isOwner(userId);

      // Users can update their own profile.
      // Admins can update any profile.
      allow update: if isOwner(userId) || isAdmin();

      // Only admins can delete users.
      allow delete: if isAdmin();
    }


    // =========================================================
    // PRODUCTS
    // =========================================================

    match /products/{productId} {

      // Public product catalogue.
      allow read: if true;

      // Only admins can modify products.
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // ORDERS
    // =========================================================

    match /orders/{orderId} {

      // Customers can read their own orders.
      // Admins can read all orders.
      allow read: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.userId == request.auth.uid
        );

      // Customers can create orders only for themselves.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Only admins can modify or delete orders.
      allow update, delete: if isAdmin();
    }


    // =========================================================
    // DENY EVERYTHING ELSE
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}