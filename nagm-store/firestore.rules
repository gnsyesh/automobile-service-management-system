rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    // Administrator authorization via admins/{uid} document
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == "admin"
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('active', false) == true;
    }


    // =========================================================
    // ADMINS COLLECTION
    // =========================================================

    match /admins/{adminId} {

      // User can read their own admin document for authorization check;
      // Active admins can read admin documents.
      allow read: if isOwner(adminId) || isAdmin();

      // Only verified active administrators can create, update, or delete admin documents.
      // Normal customers cannot create or activate admin records.
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // USERS COLLECTION
    // =========================================================

    match /users/{userId} {

      // A customer can read their own profile.
      // Admins can read customer profiles for the Customers management page.
      allow read: if isOwner(userId) || isAdmin();

      // Users can create only their own profile strictly with role: "user".
      // Admins can create profile with role: "admin" or "user".
      allow create: if isOwner(userId)
        && (
          !('role' in request.resource.data)
          || request.resource.data.role == "user"
          || isAdmin()
        );

      // Users can update their own profile fields, but CANNOT escalate their role to "admin".
      // Admins can update any profile.
      allow update: if (
        isOwner(userId)
        && (
          !('role' in request.resource.data)
          || request.resource.data.role == resource.data.get('role', 'user')
          || isAdmin()
        )
      ) || isAdmin();

      // Only admins can delete user records.
      allow delete: if isAdmin();
    }


    // =========================================================
    // PRODUCTS COLLECTION
    // =========================================================

    match /products/{productId} {

      // Public product catalogue readable by everyone.
      allow read: if true;

      // Only admins can create, update, or delete products.
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // ORDERS COLLECTION
    // =========================================================

    match /orders/{orderId} {

      // Customers can read their own orders.
      // Admins can read all orders for fulfillment and analytics.
      allow read: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.userId == request.auth.uid
        );

      // Customers can create orders only for themselves.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Only admins can update order status or delete orders.
      allow update, delete: if isAdmin();
    }


    // =========================================================
    // DENY EVERYTHING ELSE
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}